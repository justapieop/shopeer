{
  "name": "shopeer",
  "scripts": {
    "build": "pnpm --recursive run build",
    "test": "pnpm build && pnpm --recursive --if-present run test",
    "start": "node app/dist/index.js",
    "start:dev": "pnpm build && pnpm start | pnpm dlx pino-pretty",
    "db:up": "docker compose up -d --wait",
    "db:seed": "docker compose exec -T postgres psql -U shopeer -d shopeer -v ON_ERROR_STOP=1 < infra/seed/dev-seed.sql",
    "race": "node scripts/race-checkout.ts"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.4.1",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.4.1",
  "type": "module",
  "devDependencies": {
    "@types/node": "^26.5.1",
    "concurrently": "^9.2.1",
    "turbo": "^2.10.12",
    "typescript": "^7.0.2"
  }
}
